# --- Database (EU-regio; Neon Frankfurt of Supabase eu-central-1) -----------
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+3120xxxxxxx
RECORD_CALLS=false          # opnames = extra AVG-verplichtingen; standaard uit

# --- Waar de twee helften draaien ------------------------------------------
PUBLIC_BASE_URL=https://enquete.jouwdomein.nl      # Netlify: de Next.js-app
RELAY_WS_URL=wss://worker.jouwdomein.nl            # Railway/Fly: de websocket
RELAY_PORT=8081

# --- Spraak ----------------------------------------------------------------
# Geen variabele nodig: de stem staat in src/app/api/twiml/route.ts en komt van
# de Google-TTS van ConversationRelay (nl-NL-Chirp3-HD-Kore).

# --- Model -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Haiku 4.5 is snel en goedkoop — voor een telefoongesprek telt lage latency.
# Wil je rijkere gespreksafhandeling: claude-sonnet-5 (iets trager, duurder).
SURVEY_MODEL=claude-haiku-4-5

# --- Mail ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Partnerservice <partners@jouwdomein.nl>"
SUPPORT_EMAIL=partners@jouwdomein.nl   # adres op de root-pagina voor wie zijn link kwijt is

# --- Dashboard-authenticatie (Basic Auth op /dashboard) --------------------
DASHBOARD_USER=
DASHBOARD_PASS=

# --- Overig ----------------------------------------------------------------
ORG_NAME=
