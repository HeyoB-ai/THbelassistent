# --- Database (EU-regio; Neon Frankfurt of Supabase eu-central-1) -----------
DATABASE_URL=postgres://user:pass@host/db?sslmode=require

# --- Twilio ----------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+3120xxxxxxx
RECORD_CALLS=false          # opnames = extra AVG-verplichtingen; standaard uit
AMD_ENABLED=false           # antwoordapparaat-detectie. Uit: de assistent praat
                            # ook tegen een voicemail, maar hangt nooit op bij
                            # iemand die wél opneemt. Aan (true) doet Twilio's
                            # machineDetection="Enable", dat in de praktijk
                            # mensen voor een antwoordapparaat aanzag.

# --- Waar de twee helften draaien ------------------------------------------
PUBLIC_BASE_URL=https://enquete.jouwdomein.nl      # Netlify: de Next.js-app
RELAY_WS_URL=wss://worker.jouwdomein.nl            # Railway/Fly: de websocket
RELAY_PORT=8081

# --- Spraak ----------------------------------------------------------------
# De stem staat in src/app/api/twiml/route.ts (Google-TTS, nl-NL-Chirp3-HD-Kore).
#
# Turn-detection: hoe lang Twilio na spraak wacht voor de beurt voorbij is.
# 600-5000, standaard 800. Korter = sneller antwoord, meer kans dat de assistent
# je in de rede valt. Zet 'off' om het attribuut weg te laten (Twilio valt dan
# terug op 'auto') — de knop om aan te draaien als een gesprek niet doorkomt.
STT_SPEECH_TIMEOUT_MS=

# --- Model -----------------------------------------------------------------
ANTHROPIC_API_KEY=
# Haiku 4.5 is snel en goedkoop — voor een telefoongesprek telt lage latency.
# Wil je rijkere gespreksafhandeling: claude-sonnet-5 (iets trager, duurder).
SURVEY_MODEL=claude-haiku-4-5

# --- Mail ------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Partnerservice <partners@jouwdomein.nl>"
SUPPORT_EMAIL=partners@jouwdomein.nl   # adres op de root-pagina voor wie zijn link kwijt is

# --- Dashboard-authenticatie (Basic Auth op /dashboard) --------------------
DASHBOARD_USER=
DASHBOARD_PASS=

# --- Overig ----------------------------------------------------------------
ORG_NAME=
